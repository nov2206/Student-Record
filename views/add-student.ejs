<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.2/font/bootstrap-icons.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js"></script>

</head>
<body>
    <div class="container mt-5 shadow border border-2 rounded-2" style="width: 600px;">
        <div class="card-body p-4">
                      <h1 class="text-center">Add student </h1>
        </div>
        <form action="/add-student" method="post" class="p-3">
            <div class="mb-3">
                <label>First name:</label>
               <input type="text" name="fname" class="form-control " >
            </div>  
            
            <div class="mb-3">
                <label>last name:</label>
               <input type="text" name="lname" class="form-control">
            </div>  
            
            <div class="mb-3">
                <label>Email:</label>
               <input type="email" name="email" class="form-control">
            </div>  
            
            <div class="mb-3">
                <label>phone:</label>
               <input type="tel" name="phone_no" class="form-control">
            </div>

               <div class="mb-3">
                <label>Address:</label>
              <textarea name="Address" class="form-control" id="exampleFormControlTextarea2" rows="4"></textarea>
            </div>
    
            <button type="submit " class="btn  btn-primary">Submit</button>
            <a href="/" class="btn btn-solid">Cancel</a>
        </form>
    </div>
</body>
</html>